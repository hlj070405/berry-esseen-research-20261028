def lowerQ (i : Fin 65) : ℚ := (-45 + (i.val : ℚ)) / 20
def upperQ (i : Fin 65) : ℚ := (-44 + (i.val : ℚ)) / 20

theorem lowerQ_cast (i : Fin 65) : (lowerQ i : ℝ) = N2FiniteCover.lower i := by
  simp only [lowerQ, N2FiniteCover.lower, Rat.cast_div, Rat.cast_add,
    Rat.cast_neg, Rat.cast_ofNat, Rat.cast_natCast]

theorem upperQ_cast (i : Fin 65) : (upperQ i : ℝ) = N2FiniteCover.upper i := by
  simp only [upperQ, N2FiniteCover.upper, Rat.cast_div, Rat.cast_add,
    Rat.cast_neg, Rat.cast_ofNat, Rat.cast_natCast]

