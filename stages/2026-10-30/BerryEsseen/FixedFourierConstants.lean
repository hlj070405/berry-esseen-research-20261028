module

public import BerryEsseen.FixedPointEnclosure
public import BerryEsseen.RationalPiEnclosure
public import BerryEsseen.ClassicalCosineCubic

@[expose] public section

/-! 2026-10-29: generated by emit_fixed_fourier_constants.py from the frozen
n4 I operations at scale 10^40. Actual Real.pi is supplied by the proved
Machin enclosure; actual sqrt(3) by the proved integer square gates. Every
remaining candidate is checked by integer decide plus interval soundness.
The source records reciprocal witnesses explicitly and has no host oracle. -/

namespace BerryEsseen.FixedFourierConstants

open FixedPointEnclosure

def scale : ℤ := 10 ^ 40

lemma scale_positive : 0 < scale := by decide

def oneBox : Box :=
  ⟨10000000000000000000000000000000000000000, 10000000000000000000000000000000000000000, by decide⟩

theorem contains_one : Contains scale oneBox ((1 : ℝ)) := by
  have hh := contains_rat (S := scale) (p := 1) (d := 1)
    scale_positive (by decide) oneBox (by decide)
  simpa only [Int.cast_ofNat, Int.cast_one, div_one] using hh

def threeBox : Box :=
  ⟨30000000000000000000000000000000000000000, 30000000000000000000000000000000000000000, by decide⟩

theorem contains_three : Contains scale threeBox ((3 : ℝ)) := by
