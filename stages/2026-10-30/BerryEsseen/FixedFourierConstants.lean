def piBox : Box :=
  ⟨31415926535897932384626433832795028841344, 31415926535897932384626433832795028842596, by decide⟩

theorem contains_pi : Contains scale piBox (Real.pi) := by
  simpa only [Contains, qval, scale, piBox,
    RationalPiEnclosure.fixedLower, RationalPiEnclosure.fixedUpper,
    Int.cast_pow, Int.cast_ofNat] using RationalPiEnclosure.pi_fixed_enclosure

def sqrt3Box : Box :=
  ⟨17320508075688772935274463415058723669428, 17320508075688772935274463415058723669429, by decide⟩

theorem contains_sqrt3 : Contains scale sqrt3Box (Real.sqrt 3) := by
  exact FixedPointEnclosure.contains_sqrt_three_10pow40

def piSquareBox : Box :=
  ⟨98696044010893586188344909998761511349193, 98696044010893586188344909998761511357060, by decide⟩

theorem contains_piSquare : Contains scale piSquareBox (Real.pi ^ 2) := by
  exact contains_sq scale_positive contains_pi (by decide)

